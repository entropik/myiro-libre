# Désassemblages volumineux régénérables par outils/desassemble.py
Audit-MYIRO/retroanalyse/*/code.asm.txt
# Dépendances Python locales
Audit-MYIRO/outils/python-libs/
__pycache__/
# Rust
target/
target-*/
# Application : schémas générés par Tauri et copie du système graphique faite par build.rs
app/gen/
# Installateur : ponts compilés et configuration produits par outils/preparer_installateur.py
