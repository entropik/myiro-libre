app/binaries/
app/tauri.installateur.json
app/interface/systeme/

# Désassemblages et ressources extraites, volumineux et régénérables
**/code.asm.txt
*.resources/

# Travaux de rétro-analyse : contenu dérivé de binaires propriétaires, gardé en local (branche prive / codex), jamais publié
Audit-ColorGPS/
Audit-MYIRO/analyse/
Audit-MYIRO/retroanalyse/
.scratch/

# Espaces de travail des ouvriers du skill /capitaine (worktrees git temporaires)
.claude/worktrees/

# Inventaire du poste (numéros de série, adresses réseau, machines) et données d'archivage : locaux, jamais publiés
Inventaire/
Archivage/donnees/

# Jeux de test de tiers sans droit de redistribution (jeu CIEDE2000 de Sharma) : posés à la main, jamais versionnés
crates/colorimetrie/tests/donnees-locales/

# Logiciels, mises à jour et manuels Konica Minolta récupérés avant la fermeture, et leurs extractions : licence fabricant, jamais versionnés
Audit-MYIRO/logiciels/
Audit-MYIRO/extraits/

# Sources externes (manuels, captures, analyses) : copie locale de travail, droits des éditeurs, jamais publiées
docs/sources/

# Liste locale de mots interdits (voir outils/verifier_docs.py)
.mots-interdits.local
