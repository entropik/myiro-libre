{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myiro-libre",
  "version": "0.1.0",
  "identifier": "org.myiro-libre.app",
  "build": {
    "frontendDist": "interface"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "myiro-libre",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerHooks": "installateur/pare-feu.nsh"
      }
    }
  }
}
